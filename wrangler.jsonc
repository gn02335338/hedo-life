{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hedo-life",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARCHIVE",
        "class_name": "HedoArchive"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HedoArchive"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
